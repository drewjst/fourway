    "scenarios": {
      "test_retry_with_currency_keys.py": {
        "kind": "intent_a",
        "rationale": "Change A retries timeouts. That is only safe if every attempt reuses the same idempotency key, which is the thing change B rewrites. The tests use a non-default currency and a lost response (timeout_after). They check that the retry returns the single capture the gateway made, under the order's current key, and that revenue is counted once. These tests fail on base and on B alone, which do not retry."
      },
      "test_currency_requote.py": {
        "kind": "intent_b",
        "rationale": "Change B gives an order re-quoted in another currency its own capture. On the merged tree, charge() goes through change A's retry loop. These tests check that the re-quote still yields a distinct capture in the new amount and that both charges reach revenue. They fail on base and on A alone, where the gateway returns the old capture."
      },
      "test_charge_invariants.py": {
        "kind": "invariant",
        "rationale": "Properties every tree must keep, whatever the retry and key logic: an order is captured at most once, a success event fires at most once and only when charge() returns, and a decline is never retried or published. Before asserting, the tests tolerate GatewayTimeout so they hold both with and without retries."
      }
    }
  },
