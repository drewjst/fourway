      "test_surrogate_escapes_in_scanned_contexts.py": {
        "kind": "intent_a",
        "rationale": "Change A rejects 8-digit \\U escapes that land in the surrogate range. Change B rewrites how the parser moves through whitespace runs around keys, quoted keys, table headers and number/date values. These tests place surrogate \\U escapes in exactly those positions: indented keys, quoted keys followed by spaces, dotted keys, table headers, inline tables, arrays, multiline strings and lines after dates. They check that A's rejection still fires, with the correct line number, once B's bulk scanning is in place."
      },
      "test_unicode_escape_scanning_invariants.py": {
        "kind": "invariant",
        "rationale": "Every tree must keep parsing valid \\U escapes, including the boundaries U+D7FF and U+E000 and astral code points, inside contexts that B now scans in bulk. Those contexts are quoted keys with surrounding spaces, table headers, and numbers and dates on the following lines. Values must come out correctly and documents must round-trip byte for byte. Invalid hex digits and 4-digit surrogates must keep raising InvalidUnicodeValueError. All of this already holds on the base."
      }
    }
  },
