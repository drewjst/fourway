      "test_retry_async_sleep_defaults.py": {
        "kind": "intent_b",
        "rationale": "Change B makes the retry decorator keep __defaults__ and __kwdefaults__. Change A widens the decorator's sleep annotation so it accepts async sleep functions. These tests check that the attributes survive @retry(sleep=<async fn>) on a coroutine, which goes through AsyncRetrying's second functools.wraps layer. They also check that they survive retry_with copies."
      },
      "test_retry_async_sleep_runtime.py": {
        "kind": "invariant",
        "rationale": "Neither change should alter runtime retry behaviour. A custom async sleep must be awaited once per retry with the waited value. Defaults of the wrapped function must still apply when the caller omits arguments. Both checks must hold for the async and sync decorator paths that both changes touch."
      },
      "test_retry_sleep_annotation.py": {
        "kind": "intent_a",
        "rationale": "Change A widens the sleep annotation on the keyword-argument retry overload so it accepts callables returning an awaitable. The test reads that overload via typing.get_overloads, so it skips on Python before 3.11. It checks the annotation is still there after B edits the wrappers in the same module."
      }
    }
