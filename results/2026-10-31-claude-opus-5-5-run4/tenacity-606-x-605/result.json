      "test_sync_async_retry_composition.py": {
        "kind": "invariant",
        "rationale": "Change A's isinstance guard has to keep delegating to __ror__ for retry_base subclasses. Otherwise `sync_retry | async_retry` would become a synchronous retry_any that treats an un-awaited coroutine as a truthy result. This test checks that the composition still produces the async retry_any and drives a correct async-for loop. It holds on every tree."
      }
