    "scenarios": {
      "test_inline_table_key_value_separator.py": {
        "kind": "intent_a",
        "rationale": "Change A makes the separator inserted before a key appended to a ', '-spaced parsed inline table read ', '. Change B makes key_value() parse the comment trail, so the items it returns now carry a trail ('\\n', trailing spaces) and a comment. These tests check that A's spacing still holds when the appended values come from the new key_value(). They also check that when such a value's trailing space precedes the next separator, A's 'following text already starts with a space' rule keeps the output single-spaced (', w') rather than ',  w'."
      },
      "test_key_value_trailing_input.py": {
        "kind": "intent_b",
        "rationale": "Change B makes key_value() reject trailing input and makes it parse the trailing comment. These tests use inline-table style snippets, the input most likely to be copied into an inline table (the code change A touches). They also check that the comment key_value() now preserves is kept on the item, but is dropped when the item is inserted into a spaced inline table. The rendered table must keep A's spacing and still round-trip."
      },
      "test_inline_table_append_invariants.py": {
        "kind": "invariant",
        "rationale": "These properties should hold on every tree. A padded inline table such as '{ foo = 1, bar = 2 }' renders exactly '{ foo = 1, bar = 2, baz = 3}' when a key_value()-produced item is appended; A must not double-space it, and B's preserved '\\n' trail must not leak. Appending several key_value() items, with and without trailing newlines and whitespace, to a comma-separated inline table must always produce valid TOML that round-trips with the right values and never contains ',,' or ', ,'."
      }
    }
  },
