      "test_inline_dotted_roundtrip.py": {
        "kind": "invariant",
        "rationale": "Change B rewrites how dotted-key tables inside inline tables are rendered. Change A rewrites how the parser scans whitespace, bare and quoted keys, separators and EOF, which produce the key originals, seps and indents that B's renderer reuses. An unmodified parsed document must still round-trip byte-for-byte across those parser shapes on every tree. That covers spaces and tabs around dots, quoted keys, nested dotted keys, CRLF, multi-line inline tables and EOF with no newline. Replacing a sibling plain key must also leave the dotted pair intact."
      },
      "test_inline_dotted_add.py": {
        "kind": "intent_b",
        "rationale": "Change B makes keys added under a dotted-key table inside an inline table render as `prefix.child = value`, so the output parses. These tests drive that through parser inputs that change A re-implements: quoted keys at EOF without a newline, tabs and spaces around dots and `=`, nested dotted keys, and CRLF in a table section. The rendered prefix and separators come from the scanned key originals and seps. Without B, the output is corrupt and these tests fail."
      },
      "test_plain_char_source.py": {
        "kind": "intent_a",
        "rationale": "Change A removes the TOMLChar wrapper. Source then yields plain str characters, and EOF is plain str and detected by position. These tests walk inputs containing inline dotted-key tables, the documents change B re-renders, and check the character types and the deleted module. A real NUL inside such a table must still raise InvalidControlChar rather than being treated as end-of-input."
      }
    }
  },
