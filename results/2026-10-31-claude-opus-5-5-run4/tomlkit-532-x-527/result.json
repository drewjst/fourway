      },
      "test_inline_tables_in_arrays_roundtrip.py": {
        "kind": "invariant",
        "rationale": "Change A alters how values are inserted into inline tables, and change B alters how array elements are parsed. Valid inline tables inside arrays must keep working on every tree. That covers: parsing and byte-for-byte round-trips (including dotted keys, nested arrays and trailing commas), dumping Python dicts and lists that build nested inline tables inside arrays, and editing a parsed inline-table element with dict values."
      }
