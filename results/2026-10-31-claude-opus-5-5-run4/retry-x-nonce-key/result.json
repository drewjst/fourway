      "test_retry_dedup.py": {
        "kind": "invariant",
        "rationale": "Change A retries a timed-out capture and relies on the idempotency key staying the same across attempts, so the gateway deduplicates a capture whose response was lost. Change B makes every key random. After the merge, a retry following a 'timeout_after' fault is a new request to the gateway, so the customer is charged twice. On every other tree an order is captured at most once."
      },
      "test_retry_after_lost_response.py": {
        "kind": "intent_a",
        "rationale": "Change A should make a transient timeout succeed on retry, including the case where the first capture happened but its response was lost. The retry should return that same single capture and publish one success event. Base and B raise instead of retrying. After the merge the retry creates a second capture."
      },
      "test_fresh_keys_per_charge.py": {
        "kind": "intent_b",
        "rationale": "Change B should make each charge() call for the same order reach the gateway as a new request with an unseen key. That lets a customer retry after a decline, and lets a second charge produce a new capture instead of replaying the old one. Base and A reuse the key for the order."
      }
    }
  },
