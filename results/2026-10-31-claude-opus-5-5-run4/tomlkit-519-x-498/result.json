      "test_aot_header_brackets_out_of_order.py": {
        "kind": "intent_a",
        "rationale": "Change A rejects `[[...]` headers that lack their second closing bracket. Change B makes a sub-AoT header that appears after an unrelated table get merged into the parent array's last element. On base such a document raises only a generic ParseError (KeyAlreadyPresent). With B alone, the malformed header is silently accepted as `[[fruit.seeds]]`. A's specific bracket errors must still fire on exactly this path once both changes are merged."
      },
      "test_out_of_order_aot_subtables.py": {
        "kind": "intent_b",
        "rationale": "Change B lets a sub-table or sub-AoT header that follows an unrelated table extend the last element of an existing array of tables. These tests use properly closed `[[...]]` headers, which go through the bracket validation change A adds. They check that valid documents still parse, merge into the last element and stay stable when dumped and parsed again."
      },
      "test_aot_invariants.py": {
        "kind": "invariant",
        "rationale": "Both changes touch how array-of-tables headers are parsed and appended: A adds header validation and B adds a merge path in Container.append. Well-formed contiguous AoT documents must keep round-tripping byte for byte. Genuine redefinitions after an AoT must still be rejected: a plain `[fruit]` table, or a duplicate concrete sub-table. All of these already hold on base."
      }
    }
  },
