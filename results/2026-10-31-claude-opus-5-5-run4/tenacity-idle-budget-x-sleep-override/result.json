      "test_stop_before_idle_with_before_sleep.py": {
        "kind": "intent_a",
        "rationale": "Change A adds stop_before_idle, which budgets only the time spent sleeping. Change B adds an accounting step after every before_sleep callback. These tests run stop_before_idle in real retry loops that have a before_sleep callback, in sync and async form. The callback either leaves the sleep alone or rewrites it to the same value, and some runs use slow attempts. The merged accounting must not double-count sleeps. The stop must still happen right before the budget is exceeded, and time spent inside attempts must not count."
      },
      "test_before_sleep_sleep_accounting.py": {
        "kind": "intent_b",
        "rationale": "Change B makes idle_for and the statistics count the sleep a before_sleep callback sets. Change A introduces stopping that depends on idle_for, so these tests use an equivalent idle-budget stop written as a plain callable. They also check the idle_for seen at the start of each attempt and the async statistics. All three must reflect the overridden sleep."
      },
      "test_sleep_accounting_invariant.py": {
        "kind": "invariant",
        "rationale": "This property must hold on every tree whenever before_sleep leaves the sleep unchanged. The sleeps performed, the next_action.sleep reported to before_sleep_log, and statistics idle_for must all agree, with each sleep counted exactly once. The tests cover the sync and async controllers."
      }
    }
