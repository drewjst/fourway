    "scenarios": {
      "test_retry_with_currency_keys.py": {
        "kind": "intent_a",
        "rationale": "Change A retries gateway timeouts. Each retry must reuse the same idempotency key so that a lost response is deduplicated rather than charged twice. Change B moves the currency into the key, so these tests run the retry on a non-USD order. On the merge, a single capture, a single event and the right call count confirm the retries still send a stable key. Trees without A fail because the first timeout is raised."
      },
      "test_requoted_currency.py": {
        "kind": "intent_b",
        "rationale": "Change B makes a re-quoted order in another currency get its own capture instead of receiving the earlier capture back. This test charges the same order id in USD and then in EUR, and checks that the gateway records two captures with distinct keys and that revenue counts both charges. Change A rewrote the charge path that builds the key, so the merge must keep this behavior. On the base tree the second charge returns the USD capture, so the test fails there."
      },
      "test_charge_at_most_once.py": {
        "kind": "invariant",
        "rationale": "Whatever the retry policy or key format, a single order in a single currency must never be captured more than once. The success event must also be published at most once, and only for a capture that really exists. The test injects lost-response timeouts and also repeats the charge call. These properties hold on the base and on each change alone, and the merge must keep them."
      }
    }
  },
