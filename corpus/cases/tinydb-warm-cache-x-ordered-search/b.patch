new file mode 100644
index 0000000..7ad6f13
--- /dev/null
+++ b/tests/test_search_order.py
@@ -0,0 +1,25 @@
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+from tinydb.table import Document
+
+
+def test_search_returns_matches_in_id_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert(Document({'int': 1}, doc_id=5))
+    db.insert(Document({'int': 1}, doc_id=2))
+    db.insert({'int': 1})
+
+    assert [doc.doc_id for doc in db.search(where('int') == 1)] == [2, 5, 6]
+
+
+def test_cached_search_keeps_id_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert(Document({'int': 1}, doc_id=5))
+    db.insert(Document({'int': 1}, doc_id=2))
+    query = where('int') == 1
+
+    first = db.search(query)
+    second = db.search(query)
+
+    assert query in db._query_cache
+    assert [doc.doc_id for doc in first] == [doc.doc_id for doc in second] == [2, 5]
