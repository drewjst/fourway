+    def _count_changed_sleep(self, retry_state: "RetryCallState") -> None:
+        # A before_sleep callback may set upcoming_sleep, for example to honor
+        # a server's Retry-After. Count the sleep that will actually happen.
+        planned = t.cast("RetryAction", retry_state.next_action).sleep
+        if retry_state.upcoming_sleep != planned:
+            change = retry_state.upcoming_sleep - planned
+            retry_state.idle_for += change
+            self.statistics["idle_for"] += change
+            retry_state.next_action = RetryAction(retry_state.upcoming_sleep)
