@@ -0,0 +1,40 @@
+import unittest
+
+import tenacity
+from tenacity import Retrying, RetryError, stop_after_attempt
+
+
+def always_fails() -> None:
+    raise ValueError("boom")
+
+
+class TestBeforeSleepOverride(unittest.TestCase):
+    def test_before_sleep_can_change_the_sleep(self) -> None:
+        sleeps: list[float] = []
+
+        def honor_retry_after(retry_state: tenacity.RetryCallState) -> None:
+            retry_state.upcoming_sleep = 7
+
+        r = Retrying(
+            stop=stop_after_attempt(3),
+            wait=tenacity.wait_fixed(1),
+            before_sleep=honor_retry_after,
+            sleep=sleeps.append,
+        )
+        with self.assertRaises(RetryError):
+            r(always_fails)
+        self.assertEqual(sleeps, [7, 7])
+        self.assertEqual(r.statistics["idle_for"], 14)
+
+    def test_unchanged_sleep_is_counted_once(self) -> None:
+        sleeps: list[float] = []
+        r = Retrying(
+            stop=stop_after_attempt(3),
+            wait=tenacity.wait_fixed(1),
+            before_sleep=lambda rs: None,
+            sleep=sleeps.append,
+        )
+        with self.assertRaises(RetryError):
+            r(always_fails)
+        self.assertEqual(sleeps, [1, 1])
+        self.assertEqual(r.statistics["idle_for"], 2)
