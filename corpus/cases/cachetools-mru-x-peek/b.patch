@@ -0,0 +1,45 @@
+import unittest
+
+from cachetools import LFUCache, LRUCache, TTLCache
+
+
+class PeekTest(unittest.TestCase):
+    def test_peek_does_not_count_as_a_use_in_lru(self):
+        cache = LRUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        self.assertEqual(cache.peek(1), 1)
+        cache[3] = 3
+
+        self.assertNotIn(1, cache)
+        self.assertIn(2, cache)
+
+    def test_peek_does_not_count_as_a_use_in_lfu(self):
+        cache = LFUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        cache[2]
+        self.assertEqual(cache.peek(1), 1)
+        self.assertEqual(cache.peek(1), 1)
+        cache[3] = 3
+
+        self.assertNotIn(1, cache)
+        self.assertIn(2, cache)
+
+    def test_peek_missing(self):
+        cache = LRUCache[int, int](maxsize=2)
+
+        self.assertIsNone(cache.peek(1))
+        self.assertEqual(cache.peek(1, 0), 0)
+
+    def test_peek_hides_expired_items(self):
+        now = [0]
+        cache = TTLCache[int, int](maxsize=2, ttl=10, timer=lambda: now[0])
+
+        cache[1] = 1
+        self.assertEqual(cache.peek(1), 1)
+        now[0] = 10
+        self.assertIsNone(cache.peek(1))
+        self.assertEqual(cache.peek(1, 0), 0)
