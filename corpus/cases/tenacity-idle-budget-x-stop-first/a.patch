+class stop_before_idle(stop_base):
+    """
+    Stop right before the total time spent sleeping between attempts would exceed `max_idle`.
+
+    Unlike `stop_after_delay` and `stop_before_delay`, time spent inside attempts does not
+    count, so slow attempts do not use up the budget for waiting.
+    """
+
+    def __init__(self, max_idle: _utils.time_unit_type) -> None:
+        self.max_idle = _utils.to_seconds(max_idle)
+
+    @override
+    def __call__(self, retry_state: "RetryCallState") -> bool:
+        return retry_state.idle_for + retry_state.upcoming_sleep > self.max_idle
+
+
