@@ -0,0 +1,33 @@
+import unittest
+
+import tenacity
+from tenacity import Retrying
+
+from .test_tenacity import make_retry_state
+
+
+def idle_state(idle_for: float, upcoming_sleep: float) -> tenacity.RetryCallState:
+    retry_state = make_retry_state(2, 100, upcoming_sleep=upcoming_sleep)
+    retry_state.idle_for = idle_for
+    return retry_state
+
+
+class TestStopBeforeIdle(unittest.TestCase):
+    def test_stop_before_idle(self) -> None:
+        r = Retrying(stop=tenacity.stop_before_idle(2))
+        self.assertFalse(r.stop(idle_state(0, 1)))
+        self.assertFalse(r.stop(idle_state(1, 1)))
+        self.assertTrue(r.stop(idle_state(1, 1.5)))
+        self.assertTrue(r.stop(idle_state(2, 0.001)))
+
+    def test_attempt_time_does_not_count(self) -> None:
+        r = Retrying(stop=tenacity.stop_before_idle(2))
+        retry_state = idle_state(0.5, 1)
+        self.assertGreater(retry_state.seconds_since_start, 2)
+        self.assertFalse(r.stop(retry_state))
+
+    def test_time_units(self) -> None:
+        from datetime import timedelta
+
+        r = Retrying(stop=tenacity.stop_before_idle(timedelta(seconds=2)))
+        self.assertTrue(r.stop(idle_state(1, 1.5)))
