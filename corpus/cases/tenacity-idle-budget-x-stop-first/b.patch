diff --git a/tests/test_stop_first.py b/tests/test_stop_first.py
new file mode 100644
index 0000000..69110d8
--- /dev/null
+++ b/tests/test_stop_first.py
@@ -0,0 +1,42 @@
+import unittest
+
+import tenacity
+from tenacity import Retrying, RetryError, stop_after_attempt, stop_before_delay
+
+
+class CountingWait:
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, retry_state: tenacity.RetryCallState) -> float:
+        self.calls += 1
+        return 0
+
+
+def always_fails() -> None:
+    raise ValueError("boom")
+
+
+class TestStopFirst(unittest.TestCase):
+    def test_no_wait_for_the_final_attempt(self) -> None:
+        wait = CountingWait()
+        r = Retrying(stop=stop_after_attempt(3), wait=wait, sleep=lambda s: None)
+        with self.assertRaises(RetryError):
+            r(always_fails)
+        self.assertEqual(wait.calls, 2)
+
+    def test_stop_before_delay_still_sees_the_upcoming_sleep(self) -> None:
+        sleeps: list[float] = []
+        r = Retrying(
+            stop=stop_before_delay(1000),
+            wait=tenacity.wait_fixed(2000),
+            sleep=sleeps.append,
+        )
+        with self.assertRaises(RetryError):
+            r(always_fails)
+        self.assertEqual(sleeps, [])
+
+    def test_combined_stops_pass_the_need_on(self) -> None:
+        stop = stop_after_attempt(5) | stop_before_delay(1000)
+        self.assertTrue(stop.needs_upcoming_sleep)
+        self.assertFalse((stop_after_attempt(5) | stop_after_attempt(6)).needs_upcoming_sleep)
