+++ b/tests/test_get.py
@@ -0,0 +1,43 @@
+import unittest
+
+from cachetools import Cache, FIFOCache, LFUCache, LRUCache, TTLCache
+
+
+class GetTest(unittest.TestCase):
+    def test_get_reads_the_value_or_the_default(self):
+        for cache in (Cache[int, int](maxsize=2), FIFOCache[int, int](maxsize=2)):
+            cache[1] = 1
+            self.assertEqual(cache.get(1), 1)
+            self.assertIsNone(cache.get(2))
+            self.assertEqual(cache.get(2, 0), 0)
+
+    def test_get_counts_as_a_use_in_lru(self):
+        cache = LRUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        self.assertEqual(cache.get(1), 1)
+        cache[3] = 3
+
+        self.assertIn(1, cache)
+        self.assertNotIn(2, cache)
+
+    def test_get_counts_as_a_use_in_lfu(self):
+        cache = LFUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        self.assertEqual(cache.get(1), 1)
+        cache[3] = 3
+
+        self.assertIn(1, cache)
+        self.assertNotIn(2, cache)
+
+    def test_get_hides_expired_items(self):
+        now = [0]
+        cache = TTLCache[int, int](maxsize=2, ttl=10, timer=lambda: now[0])
+
+        cache[1] = 1
+        self.assertEqual(cache.get(1), 1)
+        now[0] = 10
+        self.assertIsNone(cache.get(1))
