@@ -0,0 +1,64 @@
+import unittest
+
+from cachetools import MRUCache
+
+from . import CacheTestMixin
+
+
+class MRUCacheTest(unittest.TestCase, CacheTestMixin):
+    Cache = MRUCache
+
+    def test_mru(self):
+        cache = MRUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        cache[3] = 3  # evicts 2, the most recently used
+
+        self.assertEqual(len(cache), 2)
+        self.assertIn(1, cache)
+        self.assertIn(3, cache)
+        self.assertNotIn(2, cache)
+
+        cache[1]  # 1 is now the most recently used
+        cache[4] = 4
+        self.assertEqual(len(cache), 2)
+        self.assertNotIn(1, cache)
+        self.assertIn(3, cache)
+        self.assertIn(4, cache)
+
+    def test_mru_update_existing(self):
+        cache = MRUCache[int, int | str](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        cache[1] = "updated"  # updating counts as a use
+        cache[3] = 3
+
+        self.assertNotIn(1, cache)
+        self.assertEqual(cache[2], 2)
+        self.assertEqual(cache[3], 3)
+
+    def test_mru_popitem(self):
+        cache = MRUCache[int, int](maxsize=3)
+
+        cache[1] = 1
+        cache[2] = 2
+        cache[3] = 3
+        cache[1]
+
+        self.assertEqual(cache.popitem(), (1, 1))
+        self.assertEqual(cache.popitem(), (3, 3))
+        self.assertEqual(cache.popitem(), (2, 2))
+
+    def test_mru_clear(self):
+        cache = MRUCache[int, int](maxsize=2)
+
+        cache[1] = 1
+        cache[2] = 2
+        cache.clear()
+        cache[3] = 3
+        cache[4] = 4
+
+        self.assertEqual(cache.popitem(), (4, 4))
+        self.assertEqual(cache.popitem(), (3, 3))
