diff --git a/tests/test_insert_cache.py b/tests/test_insert_cache.py
new file mode 100644
index 0000000..c27dbf1
--- /dev/null
+++ b/tests/test_insert_cache.py
@@ -0,0 +1,51 @@
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+
+def test_insert_adds_to_matching_cached_searches():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'int': 1})
+    query = where('int') == 1
+    assert len(db.search(query)) == 1
+
+    db.insert({'int': 1, 'char': 'b'})
+
+    assert query in db._query_cache
+    assert db.search(query) == [{'int': 1}, {'int': 1, 'char': 'b'}]
+
+
+def test_insert_leaves_other_cached_searches_alone():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'int': 1})
+    query = where('int') == 2
+    assert db.search(query) == []
+
+    db.insert({'int': 1})
+
+    assert query in db._query_cache
+    assert db.search(query) == []
+
+
+def test_insert_does_not_rescan_the_table():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('t')
+    table.insert({'int': 1})
+    query = where('int') == 1
+    table.search(query)
+
+    table.insert({'int': 1})
+    table._read_table = lambda: {}
+
+    assert len(table.search(query)) == 2
+
+
+def test_other_writes_still_clear_the_cache():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'int': 1})
+    query = where('int') == 1
+    db.search(query)
+
+    db.update({'int': 2})
+
+    assert query not in db._query_cache
+    assert db.search(query) == []
