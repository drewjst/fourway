@@ -0,0 +1,25 @@
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+
+def test_count_uses_the_cached_result():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('t')
+    table.insert_multiple([{'int': 1}, {'int': 1}, {'int': 2}])
+    query = where('int') == 1
+    assert table.count(query) == 2
+
+    table._read_table = lambda: {}
+
+    assert table.count(query) == 2
+
+
+def test_count_after_a_write_rereads():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'int': 1})
+    query = where('int') == 1
+    assert db.count(query) == 1
+
+    db.remove(query)
+
+    assert db.count(query) == 0
